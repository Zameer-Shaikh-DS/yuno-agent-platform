# LLM — use ONE provider (auto-detected from key prefix)
# xAI Grok: https://console.x.ai  (key starts with xai-)
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Groq free tier: https://console.groq.com  (key starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Force provider: auto | xai | groq
LLM_PROVIDER=auto

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_AGENT_ID=

# Database (docker-compose defaults)
DATABASE_URL=postgresql://yuno:yuno@postgres:5432/yuno_agents

# App
API_HOST=0.0.0.0
API_PORT=8000
MOCK_LLM=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
